# Vite only exposes variables prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:8787/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# GitHub Pages project site: /<repository-name>/; user site: /
VITE_BASE_PATH=/
# Non-secret GA4 web data stream Measurement ID, e.g. G-ABC123DEF4.
# Do not put service-account credentials or Telegram tokens in frontend env files.
VITE_GA_MEASUREMENT_ID=G-9FVG9T2JC2
